# --- Core ---
# PostgreSQL connection string. Never point development commands at production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduos"
# Separate database used by integration and e2e tests (it is reset by the test runner).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduos_test"

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Environment label: development | staging | production ---
EDUOS_ENV="development"

# --- Email provider (optional). Unset = development outbox (messages are logged, never sent). ---
EMAIL_PROVIDER=""
EMAIL_FROM="EduOS <no-reply@example.com>"

# --- AI provider (optional). Unset = AI features show "not configured". ---
AI_PROVIDER=""
AI_API_KEY=""
